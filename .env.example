# Copy to .env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Karachi

# Database (defaults to SQLite). For PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hairclub
# DB_USER=hairclub
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (console backend prints emails to the terminal during development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HairClub <no-reply@hairclub.local>

# Currency display
CURRENCY_CODE=PKR
CURRENCY_SYMBOL=Rs.
